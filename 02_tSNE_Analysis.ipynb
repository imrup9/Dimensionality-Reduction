      "source": [
        "# Optimal 2D t-SNE Embedding\n",
        "tsne_opt = TSNE(\n",
        "    n_components=2,\n",
        "    perplexity=20,\n",
        "    learning_rate=\"auto\",\n",
        "    init=\"pca\",\n",
        "    random_state=RANDOM_STATE\n",
        ")\n",
        "X_tsne_opt = tsne_opt.fit_transform(X_scaled)\n",
        "df[\"tSNE_1\"] = X_tsne_opt[:, 0]\n",
        "df[\"tSNE_2\"] = X_tsne_opt[:, 1]\n",
        "\n",
        "# Optional UMAP Embedding (graceful fallback if umap-learn is not installed)\n",
        "try:\n",
        "    import umap\n",
        "    umap_model = umap.UMAP(n_neighbors=15, min_dist=0.1, random_state=RANDOM_STATE)\n",
        "    X_umap = umap_model.fit_transform(X_scaled)\n",
        "    df[\"UMAP_1\"] = X_umap[:, 0]\n",
        "    df[\"UMAP_2\"] = X_umap[:, 1]\n",
        "    HAS_UMAP = True\n",
        "    print(\"UMAP embedding computed successfully.\")\n",
        "except ImportError:\n",
        "    HAS_UMAP = False\n",
        "    print(\"umap-learn is not installed. Run `pip install umap-learn` to include UMAP.\")"
      ]
    },
