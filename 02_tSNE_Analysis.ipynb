      "source": [
        "perplexities = [5, 15, 20, 30, 45]\n",
        "perp_results = []\n",
        "\n",
        "fig, axes = plt.subplots(1, len(perplexities), figsize=(22, 4.3))\n",
        "\n",
        "for ax, perp in zip(axes, perplexities):\n",
        "    tsne = TSNE(\n",
        "        n_components=2,\n",
        "        perplexity=perp,\n",
        "        learning_rate=\"auto\",\n",
        "        init=\"pca\",\n",
        "        random_state=RANDOM_STATE\n",
        "    )\n",
        "    emb = tsne.fit_transform(X_scaled)\n",
        "    sil = silhouette_score(emb, df[\"Cluster\"])\n",
        "    perp_results.append({\n",
        "        \"Perplexity\": perp,\n",
        "        \"KL_Divergence\": round(float(tsne.kl_divergence_), 4),\n",
        "        \"Silhouette_2D\": round(float(sil), 4)\n",
        "    })\n",
        "\n",
        "    sns.scatterplot(\n",
        "        x=emb[:, 0], y=emb[:, 1],\n",
        "        hue=df[\"Profile\"], palette=\"viridis\",\n",
        "        s=55, alpha=0.9, ax=ax, legend=(perp == perplexities[-1])\n",
        "    )\n",
        "    ax.set_title(f\"Perplexity = {perp}\\nKL={tsne.kl_divergence_:.3f} | Sil={sil:.2f}\", fontsize=11, fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"t-SNE 1\")\n",
        "    ax.set_ylabel(\"t-SNE 2\")\n",
        "\n",
        "axes[-1].legend(title=\"Academic Profile\", bbox_to_anchor=(1.04, 1), loc=\"upper left\")\n",
        "plt.suptitle(\"t-SNE Perplexity Tuning (N = 100 Students)\", fontsize=14, fontweight=\"bold\", y=1.04)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "perp_df = pd.DataFrame(perp_results)\n",
        "print(\"--- Perplexity Tuning Metrics ---\")\n",
        "perp_df"
      ]
    },
