        "import warnings\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import plotly.express as px\n",
        "\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.manifold import TSNE\n",
        "from sklearn.cluster import KMeans\n",
        "from sklearn.metrics import silhouette_score\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\", context=\"notebook\")\n",
        "RANDOM_STATE = 42\n",
        "\n",
        "# Load dataset\n",
        "df = pd.read_csv(\"student_grades.csv\")\n",
        "SUBJECTS = [\"math\", \"science\", \"cs\", \"band\", \"english\", \"history\", \"spanish\", \"physed\"]\n",
        "\n",
        "print(f\"Loaded {df.shape[0]} student records across {len(SUBJECTS)} subjects.\")\n",
        "df.head()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2665c1e7",
      "metadata": {
        "id": "2665c1e7"
      },
      "source": [
        "---\n",
        "## 2. Feature Standardization & Baseline Cluster Assignment"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "id": "6911aec3",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "6911aec3",
        "outputId": "8c9f724f-10e7-47f6-e7cc-3fa68e54c65f"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Cluster Distribution:\n",
            "Profile\n",
            "At-Risk Students                  44\n",
            "Humanities-Focused                25\n",
            "Humanities & Electives Leaders    22\n",
            "High-Achieving All-Rounders        9\n",
            "Name: count, dtype: int64\n"
          ]
        }
      ],
      "source": [
        "# Standardize the 8 numeric subject features\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(df[SUBJECTS])\n",
        "\n",
        "# Consistent 4-cluster K-Means baseline\n",
        "kmeans = KMeans(n_clusters=4, random_state=RANDOM_STATE, n_init=10)\n",
        "df[\"Cluster\"] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "PROFILE_MAP = {\n",
        "    0: \"Humanities-Focused\",\n",
        "    1: \"Humanities & Electives Leaders\",\n",
        "    2: \"At-Risk Students\",\n",
        "    3: \"High-Achieving All-Rounders\"\n",
        "}\n",
        "df[\"Profile\"] = df[\"Cluster\"].map(PROFILE_MAP)\n",
        "\n",
        "print(\"Cluster Distribution:\")\n",
        "print(df[\"Profile\"].value_counts())"
      ]
    },
