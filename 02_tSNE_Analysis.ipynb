        "        random_state=RANDOM_STATE\n",
        "    )\n",
        "    emb = tsne.fit_transform(X_scaled)\n",
        "    sil = silhouette_score(emb, df[\"Cluster\"])\n",
        "    lr_results.append({\n",
        "        \"Learning_Rate\": str(lr),\n",
        "        \"KL_Divergence\": round(float(tsne.kl_divergence_), 4),\n",
        "        \"Silhouette_2D\": round(float(sil), 4)\n",
        "    })\n",
        "\n",
        "    sns.scatterplot(\n",
        "        x=emb[:, 0], y=emb[:, 1],\n",
        "        hue=df[\"Profile\"], palette=\"viridis\",\n",
        "        s=55, alpha=0.9, ax=ax, legend=(lr == learning_rates[-1])\n",
        "    )\n",
        "    ax.set_title(f\"LR = {lr}\\nKL={tsne.kl_divergence_:.3f} | Sil={sil:.2f}\", fontsize=11, fontweight=\"bold\")\n",
        "    ax.set_xlabel(\"t-SNE 1\")\n",
        "    ax.set_ylabel(\"t-SNE 2\")\n",
        "\n",
        "axes[-1].legend(title=\"Academic Profile\", bbox_to_anchor=(1.04, 1), loc=\"upper left\")\n",
        "plt.suptitle(\"t-SNE Learning Rate Tuning (Perplexity = 20)\", fontsize=14, fontweight=\"bold\", y=1.04)\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "lr_df = pd.DataFrame(lr_results)\n",
        "print(\"--- Learning Rate Tuning Metrics ---\")\n",
        "lr_df"
      ]
    },
