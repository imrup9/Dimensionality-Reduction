      "source": [
        "# Compute mean grades and domain averages per profile\n",
        "profile_summary = df.groupby(\"Profile\")[SUBJECTS].mean().round(1)\n",
        "profile_summary[\"Count\"] = df.groupby(\"Profile\")[\"student_id\"].count()\n",
        "profile_summary[\"STEM_Avg\"] = df.groupby(\"Profile\")[[\"math\", \"science\", \"cs\"]].mean().mean(axis=1).round(1)\n",
        "profile_summary[\"Hum_Avg\"] = df.groupby(\"Profile\")[[\"english\", \"history\", \"spanish\"]].mean().mean(axis=1).round(1)\n",
        "profile_summary[\"Elec_Avg\"] = df.groupby(\"Profile\")[[\"band\", \"physed\"]].mean().mean(axis=1).round(1)\n",
        "profile_summary[\"Overall_Avg\"] = df.groupby(\"Profile\")[SUBJECTS].mean().mean(axis=1).round(1)\n",
        "\n",
        "print(\"--- Academic Profile Summary Table ---\")\n",
        "print(profile_summary)\n",
        "\n",
        "# Heatmap of average subject grades by profile\n",
        "plt.figure(figsize=(10, 4.8))\n",
        "sns.heatmap(\n",
        "    profile_summary[SUBJECTS],\n",
        "    annot=True, fmt=\".1f\", cmap=\"YlGnBu\", linewidths=0.5,\n",
        "    cbar_kws={\"label\": \"Mean Grade\"}\n",
        ")\n",
        "plt.title(\"Mean Subject Grades by Identified Academic Profile\", fontsize=13, fontweight=\"bold\")\n",
        "plt.xlabel(\"Subject\")\n",
        "plt.ylabel(\"Academic Profile\")\n",
        "plt.yticks(rotation=0)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    }
