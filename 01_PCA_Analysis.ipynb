        "# Interactive 3D PCA Scatter Plot (Plotly — hover over points to inspect individual students)\n",
        "fig_3d = px.scatter_3d(\n",
        "    df,\n",
        "    x=\"PC1\", y=\"PC2\", z=\"PC3\",\n",
        "    color=\"Profile\",\n",
        "    hover_data=[\"student_id\"] + SUBJECTS,\n",
        "    title=\"Interactive 3D PCA Student Academic Profiles (96.0% Variance)\",\n",
        "    labels={\n",
        "        \"PC1\": f\"PC1: Core Aptitude ({explained_var_pct[0]:.1f}%)\",\n",
        "        \"PC2\": f\"PC2: Electives ({explained_var_pct[1]:.1f}%)\",\n",
        "        \"PC3\": f\"PC3: STEM vs Humanities ({explained_var_pct[2]:.1f}%)\"\n",
        "    }\n",
        ")\n",
        "fig_3d.update_traces(marker=dict(size=6, line=dict(width=0.5, color=\"white\")))\n",
        "fig_3d.show()"
      ]
