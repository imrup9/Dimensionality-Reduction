        }
      ],
      "source": [
        "# Assign 4 clusters using K-Means on the standardized feature space\n",
        "kmeans = KMeans(n_clusters=4, random_state=RANDOM_STATE, n_init=10)\n",
        "df[\"Cluster\"] = kmeans.fit_predict(X_scaled)\n",
        "\n",
        "# Map numeric cluster IDs to human-readable academic profiles (verified in Section 7)\n",
        "PROFILE_MAP = {\n",
        "    0: \"Humanities-Focused\",\n",
        "    1: \"Humanities & Electives Leaders\",\n",
        "    2: \"At-Risk Students\",\n",
        "    3: \"High-Achieving All-Rounders\"\n",
        "}\n",
        "df[\"Profile\"] = df[\"Cluster\"].map(PROFILE_MAP)\n",
        "\n",
        "# Attach top 3 PC coordinates to DataFrame\n",
        "df[\"PC1\"] = X_pca_full[:, 0]\n",
        "df[\"PC2\"] = X_pca_full[:, 1]\n",
        "df[\"PC3\"] = X_pca_full[:, 2]\n",
        "\n",
        "# 2D PCA Scatter Plots: (PC1 vs PC2) and (PC1 vs PC3)\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 5.5))\n",
        "\n",
        "sns.scatterplot(\n",
        "    data=df, x=\"PC1\", y=\"PC2\", hue=\"Profile\",\n",
        "    palette=\"viridis\", s=70, alpha=0.9, ax=axes[0]\n",
        ")\n",
        "axes[0].set_title(\"2D PCA: PC1 (Core Aptitude) vs. PC2 (Electives)\", fontsize=12, fontweight=\"bold\")\n",
        "axes[0].set_xlabel(f\"PC1 ({explained_var_pct[0]:.1f}% var)\")\n",
        "axes[0].set_ylabel(f\"PC2 ({explained_var_pct[1]:.1f}% var)\")\n",
        "\n",
        "sns.scatterplot(\n",
        "    data=df, x=\"PC1\", y=\"PC3\", hue=\"Profile\",\n",
        "    palette=\"viridis\", s=70, alpha=0.9, ax=axes[1]\n",
        ")\n",
        "axes[1].set_title(\"2D PCA: PC1 (Core Aptitude) vs. PC3 (STEM vs. Humanities)\", fontsize=12, fontweight=\"bold\")\n",
        "axes[1].set_xlabel(f\"PC1 ({explained_var_pct[0]:.1f}% var)\")\n",
        "axes[1].set_ylabel(f\"PC3 ({explained_var_pct[2]:.1f}% var)\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
    },
