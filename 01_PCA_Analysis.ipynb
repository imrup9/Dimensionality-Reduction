        "# Static 3D PCA Scatter Plot (Matplotlib — captures 96.0% of total variance)\n",
        "fig = plt.figure(figsize=(10, 7))\n",
        "ax = fig.add_subplot(111, projection=\"3d\")\n",
        "\n",
        "palette = sns.color_palette(\"viridis\", n_colors=4)\n",
        "for cluster_id, profile_name in PROFILE_MAP.items():\n",
        "    subset = df[df[\"Cluster\"] == cluster_id]\n",
        "    ax.scatter(\n",
        "        subset[\"PC1\"], subset[\"PC2\"], subset[\"PC3\"],\n",
        "        label=f\"{profile_name} (n={len(subset)})\",\n",
        "        color=palette[cluster_id],\n",
        "        s=65, alpha=0.9, edgecolors=\"w\", linewidth=0.5\n",
        "    )\n",
        "\n",
        "ax.set_title(\"3D PCA Projection (96.0% Cumulative Explained Variance)\", fontsize=13, fontweight=\"bold\", pad=15)\n",
        "ax.set_xlabel(f\"PC1: Core Aptitude ({explained_var_pct[0]:.1f}%)\")\n",
        "ax.set_ylabel(f\"PC2: Electives ({explained_var_pct[1]:.1f}%)\")\n",
        "ax.set_zlabel(f\"PC3: STEM vs Humanities ({explained_var_pct[2]:.1f}%)\")\n",
        "ax.legend(loc=\"upper left\", bbox_to_anchor=(0.0, 0.95))\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ]
